# aliases for Basic commands
alias ls="eza"
alias ll="eza -al"
alias mkdir="mkdir -p"
alias cat="bat"
alias xfind="fd"
alias xgrep="rg"

# aliases for NeoVim
alias n="nvim"
alias vi=${EDITOR}
alias vim=${EDITOR}

# aliases for Docker and Docker Compose
alias dc="docker compose"
alias dcb="docker compose build"
alias dcu="docker compose up -d"
alias dcd="docker compose down"
alias dcl="docker compose logs"

# aliases for CI/CD Tools
alias k="kubectl"
alias sls="serverless"
alias tf="terraform"

# aliases for Git
alias g="git"
alias gs="git status --short"
alias ts="tig status"
alias gd="git diff"
alias gu="git pull"
alias gp="git push"
alias gl="git log"

# aliases for Python
alias pytest="uv run pytest"
alias streamlit="uv run streamlit"

# Laravel
alias sail='./vendor/bin/sail'

# Include custom aliases
if [[ -f ~/.aliases.local ]]; then
  source ~/.aliases.local
fi
