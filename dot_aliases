# aliases for Basic commands
alias ls="eza"
alias ll="eza -al"
alias mkdir="mkdir -p"
# alias cat="bat"
alias xfind="fd"
alias xgrep="rg"
alias lets-coding="zellij --layout coding"

# aliases for NeoVim
alias n="nvim"
alias vi=${EDITOR}
alias vim=${EDITOR}

# aliases for Docker and Docker Compose
alias dc="docker compose"
alias dcb="docker compose build"
alias dcu="docker compose up -d"
alias dcd="docker compose down"
alias dcl="docker compose logs"

# aliases for CI/CD Tools
alias k="kubectl"
alias sls="serverless"
alias tf="terraform"

# aliases for Git
alias g="git"
alias gs="git status --short"
alias gd="git diff"
alias gdc="npx difit" # diff last commit
alias gds="npx difit staged" # diff staging and last commit
alias gdw="npx difit working" # diff working and last commit
alias gda="npx difit ." # diff staging and working
alias gu="git pull"
alias gp="git push"
alias gl="git log"
alias t="tig"
alias ts="tig status"
alias ta="tig --all"
alias lg="lazygit"
alias gn="g n"
alias gwr="git gtr"

# alises for homebrew
alias brewup="brew update && brew upgrade && brew cleanup"

# aliases for Python
alias pytest="uv run pytest"
alias streamlit="uv run streamlit"

# Laravel
alias sail='./vendor/bin/sail'

# Claude Code
alias cc="claude"

# Include custom aliases
if [[ -f ~/.aliases.local ]]; then
  source ~/.aliases.local
fi
