#!/usr/bin/env bash
# Prevent push if commits contain temporary marker "[from now]"

set -euo pipefail

remote="${1:-origin}"
url="${2:-}"
z40="0000000000000000000000000000000000000000"
blocked_pattern="^\[from now\]" # 正規表現パターン

while read -r local_ref local_sha remote_ref remote_sha; do
  # 削除時（local_shaがゼロ）の場合はスキップ
  if [[ "$local_sha" == "$z40" ]]; then
    continue
  fi

  # 新規ブランチ or 更新ブランチの判定
  if [[ "$remote_sha" == "$z40" ]]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  # パターン検出
  if git log --oneline --grep "$blocked_pattern" "$range" | grep -q .; then
    echo >&2 "❌ Push blocked: commit(s) in $local_ref contain '[from now]'"
    echo >&2 "   Please clean up temporary commits with 'git rebase -i' before pushing."
    exit 1
  fi
done

exit 0
