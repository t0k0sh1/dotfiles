[user]
  name = Takashi Yamashina
  email = takashi.yamashina@gmail.com
[init]
  defaultBranch = main
  templateDir = ~/.git_template
[core]
  compression = 9
  whitespace = error
  preloadindex = true
  editor = vi
[advance]
  addEmptyPathspec = false
  pushNonFastForward = false
  statusHints = false
[pager]
  branch = false
  tag = false
[status]
  branch = true
  showStash = true
  showUntrackedFiles = all
[branch]
  sort = -committerdate
[tag]
  sort = -taggerdate
[push]
  autoSetupRemote = true
  default = simple
	followTags = true
[color]
  ui = auto
[color "branch"]
  current = magenta
  local = default
  remote = yellow
  upstream = green
  plain = blue
[alias]
  co = checkout -b
  n = now --all --stat
[sequence]
  editor = vi
[merge]
  tool = code --wait \"$MERGED\"
[commit]
  verbose = true
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[url "git@github.com:t0k0sh1/"]
  insteadOf = "my:"
[coderabbit]
	machineId = cli/2d16f56a31b249deab33dc4a64e13955
[gtr "editor"]
	default = cursor
[gtr "ai"]
	default = claude
