[user]
	name = Takashi Yamashina
	email = takashi.yamashina@gmail.com
[init]
	defaultBranch = main
[core]
	pager = delta
	editor = code --wait
[push]
	default = simple
[color]
	ui = auto
[alias]
	lgn = log --graph --decorate --abbrev-commit --format=format:'%C(blue)%h%C(reset) - %C(green)(%ar)%C(reset)%C(yellow)%d%C(reset)\n  %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
  diff = "!f() { \
        diff_command=\"git diff\"; \
        if [ \"$#\" -gt 0 ]; then \
            diff_command=\"$diff_command $@\"; \
        fi; \
        files=$(git diff --name-only \"$@\" | fzf --multi --preview \"$diff_command --color=always {} | delta\" --preview-window=right:60%:wrap); \
        if [ -n \"$files\" ]; then \
            eval $diff_command $files | delta; \
        fi; \
    }; f"
  co = checkout -b
[sequence]
	editor = code --wait
[interactive]
	diffFilter = delta --color-only
[delta]
  diff-so-fancy=true
  keep-plus-minus-markers=true
  minus-emph-style="bold 94 89"
  plus-emph-style="bold 29 29"
  hunk-header-style="omit"
  line-numbers=true
[merge]
	tool = code --wait \"$MERGED\"
