[user]
  name = Takashi Yamashina
  email = takashi.yamashina@gmail.com
[init]
  defaultBranch = main
  templateDir = ~/.git_template
[core]
  compression = 9
  whitespace = error
  preloadindex = true
  pager = delta
  editor = vi
[advance]
  addEmptyPathspec = false
  pushNonFastForward = false
  statusHints = false
[pager]
  branch = false
  tag = false
[status]
  branch = true
  showStash = true
  showUntrackedFiles = all
[branch]
  sort = -committerdate
[tag]
  sort = -taggerdate
[push]
  autoSetupRemote = true
  default = simple
  followTags = true
[color]
  ui = auto
[color "branch"]
  current = magenta
  local = default
  remote = yellow
  upstream = green
  plain = blue
[alias]
  lgn = log --graph --decorate --abbrev-commit --format=format:'%C(blue)%h%C(reset) - %C(green)(%ar)%C(reset)%C(yellow)%d%C(reset)\n  %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
  diff = "!f() { \
        diff_command=\"git diff\"; \
        if [ \"$#\" -gt 0 ]; then \
            diff_command=\"$diff_command $@\"; \
        fi; \
        files=$(git diff --name-only \"$@\" | fzf --multi --preview \"$diff_command --color=always {} | delta\" --preview-window=right:60%:wrap); \
        if [ -n \"$files\" ]; then \
            eval $diff_command $files | delta; \
        fi; \
    }; f"
  co = checkout -b
  n = now --all --stat
[sequence]
  editor = vi
[interactive]
  diffFilter = delta --color-only
[delta]
  diff-so-fancy=true
  keep-plus-minus-markers=true
  minus-emph-style="bold 94 89"
  plus-emph-style="bold 29 29"
  hunk-header-style="omit"
  line-numbers=true
[merge]
  tool = code --wait \"$MERGED\"
[commit]
  verbose = true
  template = ~/.gitmessage.txt
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[url "git@github.com:t0k0sh1/"]
  insteadOf = "my:"
